# Configuration

# Server Config
#################################################################
# SERVER_URL = Protocol + HOST + :Port (no slash at the end)
SERVER_URL=http://xxxx:8000

# OneM2M Config
#################################################################
# ONE_M2M_CSE_URL = Protocol + HOST + [:Port] + "/" + CSE Name
ONE_M2M_CSE_URL=http://xxxx:8080/cse-in

# Django / Email
#################################################################
SECRET_KEY=xxxx
EMAIL_HOST_USER=xxxx
EMAIL_HOST_PASSWORD=xxxx
